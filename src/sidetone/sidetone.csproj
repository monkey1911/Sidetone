<Project Sdk="Microsoft.NET.Sdk">

  <!--
    sidetone - the graphical front end of Sidetone (Avalonia).
    The console itself is the core's DispatchConsole; this project is windows, controls and themes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sidetone</AssemblyName>
    <RootNamespace>Sidetone.Gui</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Windows: .NET's globalization (Windows's own ICU) converts IANA time zones; the culture stays invariant (DesktopPlatform) -->
    <InvariantGlobalization Condition="$(RuntimeIdentifier.StartsWith('win'))">false</InvariantGlobalization>
    <AvaloniaVersion>12.1.6</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\sidetone-core\sidetone-core.csproj" />
    <Using Include="Sidetone.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <!-- opt-in native Wayland backend (the wayland option); XWayland is the default -->
    <PackageReference Include="Avalonia.Wayland" Version="$(AvaloniaVersion)" />
    <!-- off-screen rendering for the screenshot option (CI uses it to check the window in both themes) -->
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <!-- the icon: used for the window and written out when Sidetone is added to the app launcher -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\packaging\icons\sidetone.svg" LogicalName="sidetone.svg" />
    <EmbeddedResource Include="..\..\packaging\icons\sidetone-256.png" LogicalName="sidetone-256.png" />
  </ItemGroup>

  <!-- libvocoder.so built by CMake (see CI) is copied next to sidetone when present -->
  <ItemGroup>
    <None Include="..\..\build\native\libvocoder.so" Condition="Exists('..\..\build\native\libvocoder.so')">
      <Link>libvocoder.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
