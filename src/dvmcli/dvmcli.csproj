<Project Sdk="Microsoft.NET.Sdk">

  <!--
    dvmcli - the terminal front end of the Linux DVM console (TUI, listen, ptt, devices, selftest).
    Everything that isn't terminal-specific lives in dvmcore.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dvmcli</AssemblyName>
    <RootNamespace>dvmcli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\dvmcore\dvmcore.csproj" />
    <Using Include="dvmcore" />
  </ItemGroup>

  <!-- libvocoder.so built by CMake (see CI) is copied next to dvmcli when present -->
  <ItemGroup>
    <None Include="..\..\build\native\libvocoder.so" Condition="Exists('..\..\build\native\libvocoder.so')">
      <Link>libvocoder.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
